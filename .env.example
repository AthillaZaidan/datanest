# Copy to .env and fill in the blanks. Never commit .env.

# --- Server ---
APP_PORT=8080
ALLOWED_ORIGIN=http://localhost:5173
# true only behind HTTPS
COOKIE_SECURE=false

# --- Platform database (docker compose: platform-pg) ---
PLATFORM_DSN=postgres://datanest:datanest@localhost:5432/datanest_platform?sslmode=disable

# --- Initial admin (seeded only when no admin exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Encryption key for target DB passwords (32 bytes, base64) ---
# Generate with: openssl rand -base64 32
CREDENTIALS_KEY=

# --- Session ---
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_ROTATION_INTERVAL=15m
SESSION_GRACE_PERIOD=30s
SESSION_CLEANUP_INTERVAL=1m

# --- Target database access ---
TARGET_QUERY_TIMEOUT=5s
MIGRATION_LOCK_TIMEOUT=5s
MIGRATION_STATEMENT_TIMEOUT=60s
MIGRATION_EXEC_TIMEOUT=2m

# --- Integration tests (docker compose: test-pg) ---
TEST_PLATFORM_DSN=postgres://datanest_test:datanest_test@localhost:5434/datanest_test_platform?sslmode=disable
TEST_TARGET_DSN=postgres://datanest_test:datanest_test@localhost:5434/datanest_test_target?sslmode=disable
