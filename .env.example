# Copy to .env and fill in the blanks. Never commit .env.

# --- Server ---
APP_PORT=8080
ALLOWED_ORIGIN=http://localhost:8080
# true only behind HTTPS
COOKIE_SECURE=false

# --- Platform database (docker compose: platform-pg) ---
PLATFORM_DSN=postgres://datanest:datanest@localhost:15432/datanest_platform?sslmode=disable

# --- Logs and traces ---
# Logs are JSON on stdout. TRACE_EXPORTER=console prints spans to stderr; none turns tracing off.
LOG_LEVEL=info
TRACE_EXPORTER=console

# --- Observability bonus (docker compose --profile observability up -d lgtm) ---
# Prometheus /metrics listeners; "off" turns one off. Run a second worker with WORKER_METRICS_ADDR=:9102.
METRICS_ADDR=:9100
WORKER_METRICS_ADDR=:9101
# OpenTelemetry Collector (OTLP/HTTP) for logs and traces, e.g. http://localhost:4318; empty keeps them local.
OTLP_ENDPOINT=

# --- Job queue (docker compose: rabbitmq); leave empty to run without it ---
AMQP_URL=amqp://datanest:datanest@localhost:15673/

# --- Worker (go run ./cmd/worker) ---
WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE=30s
WORKER_HEARTBEAT=10s
WORKER_SWEEP_INTERVAL=5s
WORKER_REPUBLISH_AFTER=30s

# --- Initial admin (seeded only when no admin exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Encryption key for target DB passwords (32 bytes, base64) ---
# Generate with: openssl rand -base64 32
CREDENTIALS_KEY=

# --- Session ---
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_ROTATION_INTERVAL=15m
SESSION_GRACE_PERIOD=30s
SESSION_CLEANUP_INTERVAL=1m

# --- Target database access ---
TARGET_QUERY_TIMEOUT=5s
MIGRATION_LOCK_TIMEOUT=5s
MIGRATION_STATEMENT_TIMEOUT=60s
MIGRATION_EXEC_TIMEOUT=2m

# --- Integration tests (docker compose: test-pg) ---
TEST_PLATFORM_DSN=postgres://datanest_test:datanest_test@localhost:15434/datanest_test_platform?sslmode=disable
TEST_TARGET_DSN=postgres://datanest_test:datanest_test@localhost:15434/datanest_test_target?sslmode=disable

# --- Integration tests (docker compose: rabbitmq); tests skip when empty ---
TEST_AMQP_URL=amqp://datanest:datanest@localhost:15673/
